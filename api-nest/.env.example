PORT=3000
API_KEY=cambia-esta-clave
DATA_FILE=data/equipos.json
# Ruta del ScanGP.exe compilado que se entrega en la descarga
SCANGP_EXE=../agente-windows/dist/ScanGP.exe
# URL que usarán los equipos para enviar su inventario. Si se deja vacía se usa la IP local del servidor.
# En producción: https://tu-dominio.com/api/inventario
SCANGP_URL_SERVIDOR=

# SQL Server (crear base y usuarios con db/setup.sql; ver README)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ScanGP
DB_APP_USER=scangp_app
DB_APP_PASSWORD=
DB_MIGRATIONS_USER=scangp_migraciones
DB_MIGRATIONS_PASSWORD=
# true solo en desarrollo (certificado autofirmado de SQL Server)
DB_TRUST_SERVER_CERTIFICATE=false

# Sesión web: secreto aleatorio de al menos 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Carpeta de los documentos adjuntos (facturas, actas…)
DOCUMENTOS_DIR=data/documentos

# Alta automática de activos y componentes al recibir ScanGP (false conserva el alta manual).
SCANGP_REGISTRO_AUTOMATICO=true
